# New API administrator console.
# DNS: admin.jevhub.store A 43.135.155.97
# Generate the password hash with: caddy hash-password --plaintext '<password>'

admin.jevhub.store {
	encode gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
	}

	# New API's `/` is its public product landing page. Keep this hostname
	# focused on administration by taking operators straight to user management.
	@admin_homepage path /
	redir @admin_homepage /users/ 302

	# Customer sign-up belongs to the branded JEV storefront, not this console.
	@customer_registration path /register /register/*
	redir @customer_registration https://jevhub.store/sign-up 302

	@customer_registration_api path /api/user/register
	respond @customer_registration_api "Customer registration is available at https://jevhub.store/sign-up" 403

	reverse_proxy 127.0.0.1:3001
}
