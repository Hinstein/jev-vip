# Core application
POSTGRES_URL=postgresql://user:password@127.0.0.1:5432/jev_vip
BASE_URL=https://jev.example.com
AUTH_SECRET=replace-with-a-long-random-secret

# OfferKit runs as a separate voucher infrastructure service.
# Keep this API key server-side only.
OFFERKIT_API_URL=https://offerkit.example.com
OFFERKIT_API_KEY=offerkit_***
OFFERKIT_REDEEM_CURRENCY=CNY
OFFERKIT_REDEEM_AMOUNT_MINOR=1

# Map the three JEV products to the actual OfferKit campaign UUIDs.
OFFERKIT_CAMPAIGN_JEV_10=
OFFERKIT_CAMPAIGN_JEV_30=
OFFERKIT_CAMPAIGN_JEV_50=

# Optional public Xianyu product URLs.
XIANYU_STARTER_URL=
XIANYU_STANDARD_URL=
XIANYU_PRO_URL=

# Optional Umami web analytics.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.auturance.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=


# LiteLLM relay (internal only)
# Keep the gateway bound to localhost or a private network.
LITELLM_PROXY_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-master-key
LITELLM_SALT_KEY=replace-with-a-long-random-salt-and-never-rotate-it
LITELLM_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/jev_litellm

# Official TypeSafe / JEV upstream credential. This exists only in LiteLLM.
TYPESAFE_API_BASE=https://api.typesafe.ai
TYPESAFE_API_KEY=replace-with-official-typesafe-key
