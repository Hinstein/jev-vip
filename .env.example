# Custom JEV/ZEV frontend
BASE_URL=http://localhost:3000

# New API is the sole business backend.
# Browser /api/* requests are reverse-proxied to this internal URL.
NEW_API_INTERNAL_URL=http://127.0.0.1:3001

# Public API endpoint shown to customers. Point it directly at New API.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1

# Optional link for operators. Do not expose the Root account to customers.
NEXT_PUBLIC_NEW_API_ADMIN_URL=https://admin.example.com

# Optional Xianyu product URLs.
NEXT_PUBLIC_XIANYU_STARTER_URL=
NEXT_PUBLIC_XIANYU_STANDARD_URL=
NEXT_PUBLIC_XIANYU_PRO_URL=

# New API container secrets (used by docker-compose.new-api.yml)
NEW_API_SESSION_SECRET=replace-with-a-long-random-session-secret
NEW_API_CRYPTO_SECRET=replace-with-a-long-random-crypto-secret
NEW_API_SQL_DSN=
NEW_API_REDIS_CONN_STRING=
NEW_API_TRUSTED_FRONTEND=http://localhost:3000
