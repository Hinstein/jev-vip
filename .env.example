# ZEV frontend / local auth shell
POSTGRES_URL=postgresql://user:password@127.0.0.1:5432/jev_vip
BASE_URL=https://zev.example.com
AUTH_SECRET=replace-with-a-long-random-secret

# New API is the business backend: users mirror, quota, redemption, API keys,
# gateway, usage, logs and admin console.
NEW_API_BASE_URL=http://127.0.0.1:3001
NEW_API_JEV_MODEL=jev
# Optional: separate HMAC secret used to derive private service credentials for
# mirrored New API users. Falls back to AUTH_SECRET when omitted.
NEW_API_IDENTITY_SECRET=replace-with-a-long-random-secret

# New API Docker backend
NEW_API_DB_PASSWORD=replace-with-a-strong-password
NEW_API_REDIS_PASSWORD=replace-with-a-strong-password
NEW_API_SESSION_SECRET=replace-with-a-long-random-session-secret
NEW_API_SESSION_COOKIE_SECURE=false
NEW_API_SESSION_COOKIE_TRUSTED_URL=

# Internal protocol adapter. Configure the New API OpenAI-compatible channel
# with the same key and base URL http://jev-adapter:4100.
JEV_ADAPTER_SHARED_KEY=sk-internal-replace-me

# Official TypeSafe / JEV upstream credential. Only the adapter sees this.
TYPESAFE_API_BASE=https://api.typesafe.ai
TYPESAFE_API_KEY=replace-with-official-typesafe-key

# Optional public Xianyu product URLs.
XIANYU_STARTER_URL=
XIANYU_STANDARD_URL=
XIANYU_PRO_URL=
